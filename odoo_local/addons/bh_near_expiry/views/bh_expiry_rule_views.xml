<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bh_expiry_rule_view_list" model="ir.ui.view">
        <field name="name">bh.expiry.rule.list</field>
        <field name="model">bh.expiry.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="categ_id"/>
                <field name="stage"/>
                <field name="max_remaining_pct"/>
                <field name="discount_pct"/>
                <field name="responsible_id"/>
                <field name="note" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="bh_expiry_rule_action" model="ir.actions.act_window">
        <field name="name">Quy tắc cận hạn</field>
        <field name="res_model">bh.expiry.rule</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
