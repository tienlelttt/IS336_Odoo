      <bpmn:outgoing>Flow_QT3_san_xuat_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Báo Mua (QT2), dời mẻ">
      <bpmn:incoming>Flow_QT3_san_xuat_3</bpmn:incoming>
      <bpmn:outgoing>Flow_QT3_san_xuat_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T4" name="Xác nhận lệnh, in phiếu sản xuất cho thợ">
      <bpmn:incoming>Flow_QT3_san_xuat_4</bpmn:incoming>
      <bpmn:incoming>Flow_QT3_san_xuat_5</bpmn:incoming>
      <bpmn:outgoing>Flow_QT3_san_xuat_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T5" name="Sinh phiếu cấp NVL; BH5 tạo phiếu QC">
      <bpmn:incoming>Flow_QT3_san_xuat_6</bpmn:incoming>
      <bpmn:outgoing>Flow_QT3_san_xuat_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T6" name="16:30 cấp NVL cả ca ra khu sản xuất (lô FEFO)">
      <bpmn:incoming>Flow_QT3_san_xuat_7</bpmn:incoming>
      <bpmn:outgoing>Flow_QT3_san_xuat_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="T7" name="22:00-05:00 làm bánh theo phiếu, ghi sổ ca">
      <bpmn:incoming>Flow_QT3_san_xuat_8</bpmn:incoming>
      <bpmn:outgoing>Flow_QT3_san_xuat_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="T8" name="05:00 lấy mẫu từng lô, nhập kết quả phiếu QC">
      <bpmn:incoming>Flow_QT3_san_xuat_9</bpmn:incoming>
      <bpmn:outgoing>Flow_QT3_san_xuat_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T9" name="Nhập sản lượng thực tế, lô; ghi bánh lỗi (loại bỏ)">
      <bpmn:incoming>Flow_QT3_san_xuat_10</bpmn:incoming>
      <bpmn:outgoing>Flow_QT3_san_xuat_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="Làm thiếu kế hoạch?">
