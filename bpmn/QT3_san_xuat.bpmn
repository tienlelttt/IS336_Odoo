  <bpmn:collaboration id="Collaboration_QT3_san_xuat">
    <bpmn:participant id="Participant_QT3_san_xuat" name="QT3 - Sản xuất theo mẻ: Odoo cho quản đốc xưởng (Manufacturing) - Công ty TNHH Bánh Bảo Hân" processRef="Process_QT3_san_xuat" />
  </bpmn:collaboration>
  <bpmn:process id="Process_QT3_san_xuat" isExecutable="false">
    <bpmn:laneSet id="LaneSet_QT3_san_xuat">
      <bpmn:lane id="Lane_QT3_san_xuat_0" name="Hệ thống Odoo">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
