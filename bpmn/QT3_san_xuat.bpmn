        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT3_san_xuat_2" name="Thủ kho">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT3_san_xuat_3" name="Tổ sản xuất (không dùng Odoo)">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT3_san_xuat_4" name="QC">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="16:00 chốt đơn ngày mai">
      <bpmn:outgoing>Flow_QT3_san_xuat_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_S1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Bổ sung hàng: tồn dự báo đã trừ đơn bán">
      <bpmn:incoming>Flow_QT3_san_xuat_0</bpmn:incoming>
      <bpmn:outgoing>Flow_QT3_san_xuat_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T2" name="Chốt số lượng theo mẻ, đặt hàng, gộp lệnh cùng sản phẩm">
      <bpmn:incoming>Flow_QT3_san_xuat_1</bpmn:incoming>
      <bpmn:outgoing>Flow_QT3_san_xuat_2</bpmn:outgoing>
    </bpmn:userTask>
