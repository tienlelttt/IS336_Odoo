      <bpmn:outgoing>Flow_QT3_san_xuat_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T12" name="Trừ NVL theo định mức, phụ phẩm, nhập thành phẩm theo nhiệt độ, giá thành">
      <bpmn:incoming>Flow_QT3_san_xuat_13</bpmn:incoming>
      <bpmn:incoming>Flow_QT3_san_xuat_16</bpmn:incoming>
      <bpmn:incoming>Flow_QT3_san_xuat_17</bpmn:incoming>
      <bpmn:outgoing>Flow_QT3_san_xuat_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T13" name="17:00 đếm NVL dư ở khu sản xuất">
      <bpmn:incoming>Flow_QT3_san_xuat_18</bpmn:incoming>
      <bpmn:outgoing>Flow_QT3_san_xuat_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T14" name="Thứ Hai: xem sản lượng, bánh lỗi, tiêu hao, tải lò">
      <bpmn:incoming>Flow_QT3_san_xuat_19</bpmn:incoming>
