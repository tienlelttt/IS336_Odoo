      <bpmn:incoming>Flow_QT2_mua_hang_12</bpmn:incoming>
      <bpmn:incoming>Flow_QT2_mua_hang_13</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T10" name="Hóa đơn NCC theo số đã nhận, đối chiếu 3 bên">
      <bpmn:incoming>Flow_QT2_mua_hang_14</bpmn:incoming>
      <bpmn:incoming>Flow_QT2_mua_hang_17</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Khớp giá, số lượng?">
