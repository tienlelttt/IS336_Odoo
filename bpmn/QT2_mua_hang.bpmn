      <bpmn:outgoing>Flow_QT2_mua_hang_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T7" name="Kiểm nhiệt độ, hạn dùng, bao bì, đếm hàng hỏng">
