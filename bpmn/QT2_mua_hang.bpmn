    <bpmn:laneSet id="LaneSet_QT2_mua_hang">
      <bpmn:lane id="Lane_QT2_mua_hang_0" name="Giám đốc">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT2_mua_hang_1" name="Nhân viên mua hàng">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
      </bpmn:lane>
