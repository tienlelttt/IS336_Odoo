      <bpmn:outgoing>Flow_QT2_mua_hang_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_QT2_mua_hang_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T8" name="Trả phần không đạt cho xe NCC, ghi lý do">
      <bpmn:incoming>Flow_QT2_mua_hang_11</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_12</bpmn:outgoing>
    </bpmn:userTask>
