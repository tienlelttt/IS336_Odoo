        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT2_mua_hang_3" name="Nhà cung cấp">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT2_mua_hang_4" name="Thủ kho">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT2_mua_hang_5" name="QC">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT2_mua_hang_6" name="Kế toán">
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="16:30, sau khi lập kế hoạch sản xuất">
      <bpmn:outgoing>Flow_QT2_mua_hang_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_S1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Bổ sung hàng: đề xuất đơn mua theo giá thỏa thuận quý">
      <bpmn:incoming>Flow_QT2_mua_hang_0</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T2" name="Kiểm số lượng, gom theo NCC, gửi đơn (email, Zalo)">
      <bpmn:incoming>Flow_QT2_mua_hang_1</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Đơn trên 20 triệu?">
      <bpmn:incoming>Flow_QT2_mua_hang_2</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_QT2_mua_hang_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Duyệt đơn mua">
      <bpmn:incoming>Flow_QT2_mua_hang_3</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_4</bpmn:outgoing>
    </bpmn:userTask>
