      <bpmn:incoming>Flow_QT2_mua_hang_5</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T5" name="Giao hàng kèm hóa đơn, số lô, hạn dùng">
      <bpmn:incoming>Flow_QT2_mua_hang_6</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T6" name="Xe đến (phiếu nhập sẵn sàng): tạo phiếu QC">
