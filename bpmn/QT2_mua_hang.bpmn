  <bpmn:collaboration id="Collaboration_QT2_mua_hang">
    <bpmn:participant id="Participant_QT2_mua_hang" name="QT2 - Đặt nguyên liệu, nhận hàng, trả tiền (Procure to Pay) - Công ty TNHH Bánh Bảo Hân" processRef="Process_QT2_mua_hang" />
  </bpmn:collaboration>
