    <bpmn:participant id="Participant_QT2_mua_hang_Main" name="Công ty TNHH Bánh Bảo Hân" processRef="Process_QT2_mua_hang_Main" />
    <bpmn:messageFlow id="Flow_QT2_mua_hang_6" name="Đơn mua" sourceRef="T4" targetRef="T5" />
    <bpmn:messageFlow id="Flow_QT2_mua_hang_7" name="Hàng, hóa đơn, lô" sourceRef="T5" targetRef="T6" />
  </bpmn:collaboration>
  <bpmn:process id="Process_QT2_mua_hang_Ext0" isExecutable="false">
    <bpmn:task id="T5" name="Giao hàng kèm hóa đơn, số lô, hạn dùng">
    </bpmn:task>
  </bpmn:process>
  <bpmn:process id="Process_QT2_mua_hang_Main" name="QT2 - Đặt nguyên liệu, nhận hàng, trả tiền (Procure to Pay) - Công ty TNHH Bánh Bảo Hân" isExecutable="false">
    <bpmn:laneSet id="LaneSet_QT2_mua_hang">
      <bpmn:lane id="Lane_QT2_mua_hang_0" name="Giám đốc">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT2_mua_hang_1" name="Nhân viên mua hàng">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT2_mua_hang_2" name="Hệ thống Odoo">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT2_mua_hang_3" name="Thủ kho">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT2_mua_hang_4" name="QC">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT2_mua_hang_5" name="Kế toán">
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="16:30, sau khi lập kế hoạch sản xuất">
      <bpmn:outgoing>Flow_QT2_mua_hang_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_S1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Bổ sung hàng: đề xuất đơn mua theo giá thỏa thuận quý">
      <bpmn:incoming>Flow_QT2_mua_hang_0</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T2" name="Kiểm số lượng, gom theo NCC, gửi đơn (email, Zalo)">
      <bpmn:incoming>Flow_QT2_mua_hang_1</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Đơn trên 20 triệu?">
      <bpmn:incoming>Flow_QT2_mua_hang_2</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_QT2_mua_hang_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Duyệt đơn mua">
      <bpmn:incoming>Flow_QT2_mua_hang_3</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T4" name="Xác nhận đơn mua">
      <bpmn:incoming>Flow_QT2_mua_hang_4</bpmn:incoming>
      <bpmn:incoming>Flow_QT2_mua_hang_5</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T6" name="Xe đến (phiếu nhập sẵn sàng): tạo phiếu QC">
      <bpmn:incoming>Flow_QT2_mua_hang_8</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T7" name="Kiểm nhiệt độ, hạn dùng, bao bì, đếm hàng hỏng">
      <bpmn:incoming>Flow_QT2_mua_hang_9</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_10</bpmn:outgoing>
    </bpmn:userTask>
