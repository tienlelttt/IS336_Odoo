    <bpmn:userTask id="T8" name="Trả phần không đạt cho xe NCC, ghi lý do">
      <bpmn:incoming>Flow_QT2_mua_hang_10</bpmn:incoming>
      <bpmn:outgoing>Flow_QT2_mua_hang_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T9" name="Nhận số đạt, ghi lô, hạn dùng; hàng vào vị trí theo nhóm">
