      <bpmn:outgoing>Flow_QT0_tong_quan_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_QT0_tong_quan_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="C2" name="QT2 Đặt NVL theo hợp đồng giá, QC tại cửa, nhận hàng">
      <bpmn:incoming>Flow_QT0_tong_quan_4</bpmn:incoming>
      <bpmn:outgoing>Flow_QT0_tong_quan_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_QT0_tong_quan_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="T2" name="Cấp NVL cho ca; QC kiểm mẫu thành phẩm">
