      <bpmn:outgoing>Flow_QT0_tong_quan_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="C5" name="QT5 Hóa đơn theo số giao, thu tiền, đối soát, trả NCC">
