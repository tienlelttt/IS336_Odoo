  <bpmn:collaboration id="Collaboration_QT0_tong_quan">
    <bpmn:participant id="Participant_QT0_tong_quan" name="Tổng quan hệ thống - Luồng tích hợp 5 quy trình trong một ngày vận hành - Công ty TNHH Bánh Bảo Hân" processRef="Process_QT0_tong_quan" />
  </bpmn:collaboration>
  <bpmn:process id="Process_QT0_tong_quan" isExecutable="false">
    <bpmn:laneSet id="LaneSet_QT0_tong_quan">
      <bpmn:lane id="Lane_QT0_tong_quan_0" name="Khách hàng sỉ">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT0_tong_quan_1" name="Kinh doanh">
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT0_tong_quan_2" name="Hệ thống Odoo">
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT0_tong_quan_3" name="Quản đốc sản xuất">
        <bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT0_tong_quan_4" name="Kho - QC">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT0_tong_quan_5" name="Mua hàng">
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT0_tong_quan_6" name="Kế toán">
        <bpmn:flowNodeRef>C5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Đặt bánh cho ngày mai">
      <bpmn:outgoing>Flow_QT0_tong_quan_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="C1" name="QT1 Nhận đơn, kiểm tra công nợ, xác nhận trước 16:00">
      <bpmn:incoming>Flow_QT0_tong_quan_0</bpmn:incoming>
      <bpmn:outgoing>Flow_QT0_tong_quan_1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="T1" name="Tồn dự báo trừ đơn đã xác nhận">
      <bpmn:incoming>Flow_QT0_tong_quan_1</bpmn:incoming>
      <bpmn:outgoing>Flow_QT0_tong_quan_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="C3" name="QT3 Lập kế hoạch mẻ, lệnh sản xuất theo ca">
      <bpmn:incoming>Flow_QT0_tong_quan_2</bpmn:incoming>
      <bpmn:outgoing>Flow_QT0_tong_quan_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="G1" name="Đủ nguyên liệu?">
