      <bpmn:incoming>Flow_QT0_tong_quan_11</bpmn:incoming>
      <bpmn:outgoing>Flow_QT0_tong_quan_12</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="T5" name="Cập nhật công nợ; nợ quá hạn chặn đơn mới">
