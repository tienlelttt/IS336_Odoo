        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT1_ban_hang_3" name="Hệ thống Odoo">
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT1_ban_hang_4" name="Thủ kho">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT1_ban_hang_5" name="Tài xế">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT1_ban_hang_6" name="Kế toán">
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Đặt bánh cho ngày mai (Zalo, điện thoại, cổng, API)">
      <bpmn:outgoing>Flow_QT1_ban_hang_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Nhập đơn bán, ngày giao mai (đơn cố định: nhân bản)">
      <bpmn:incoming>Flow_QT1_ban_hang_0</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Nợ quá hạn hoặc vượt hạn mức?">
      <bpmn:incoming>Flow_QT1_ban_hang_1</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_QT1_ban_hang_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T2" name="Chặn xác nhận, giao việc giám đốc">
      <bpmn:incoming>Flow_QT1_ban_hang_2</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T3" name="Xem công nợ, gắn nhãn Đã duyệt công nợ">
      <bpmn:incoming>Flow_QT1_ban_hang_3</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="Cho giao?">
      <bpmn:incoming>Flow_QT1_ban_hang_4</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_QT1_ban_hang_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E0" name="Từ chối, kinh doanh báo khách">
      <bpmn:incoming>Flow_QT1_ban_hang_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T4" name="Xác nhận đơn trước 16:00">
      <bpmn:incoming>Flow_QT1_ban_hang_6</bpmn:incoming>
      <bpmn:incoming>Flow_QT1_ban_hang_7</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T5" name="Tồn dự báo giảm, vào kế hoạch sản xuất (QT3)">
      <bpmn:incoming>Flow_QT1_ban_hang_8</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T6" name="05:00 soạn hàng theo tuyến, lô FEFO">
      <bpmn:incoming>Flow_QT1_ban_hang_9</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T7" name="Giao, khách ký; thu tiền mặt quán nhỏ; nhận hàng thu hồi">
      <bpmn:incoming>Flow_QT1_ban_hang_10</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Khách nhận đủ?">
