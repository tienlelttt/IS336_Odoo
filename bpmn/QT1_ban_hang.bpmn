  <bpmn:collaboration id="Collaboration_QT1_ban_hang">
    <bpmn:participant id="Participant_QT1_ban_hang" name="QT1 - Nhận đơn, giao hàng, thu tiền (Order to Cash) - Công ty TNHH Bánh Bảo Hân" processRef="Process_QT1_ban_hang" />
  </bpmn:collaboration>
  <bpmn:process id="Process_QT1_ban_hang" isExecutable="false">
    <bpmn:laneSet id="LaneSet_QT1_ban_hang">
      <bpmn:lane id="Lane_QT1_ban_hang_0" name="Khách hàng sỉ">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT1_ban_hang_1" name="Nhân viên kinh doanh">
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QT1_ban_hang_2" name="Giám đốc">
