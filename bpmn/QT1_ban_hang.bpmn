      <bpmn:outgoing>Flow_QT1_ban_hang_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_QT1_ban_hang_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T11" name="Nhận tiền tài xế nộp, đối chiếu phiếu giao">
      <bpmn:incoming>Flow_QT1_ban_hang_17</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_19</bpmn:outgoing>
    </bpmn:userTask>
