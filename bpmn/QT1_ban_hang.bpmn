      <bpmn:incoming>Flow_QT1_ban_hang_14</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T10" name="Cuối ngày: hóa đơn hàng loạt theo số đã giao, phát hành HĐĐT">
      <bpmn:incoming>Flow_QT1_ban_hang_15</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G4" name="Trả tiền mặt?">
