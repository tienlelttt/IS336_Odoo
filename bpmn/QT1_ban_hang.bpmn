  </bpmn:process>
  <bpmn:process id="Process_QT1_ban_hang_Main" name="QT1 - Nhận đơn, giao hàng, thu tiền (Order to Cash) - Công ty TNHH Bánh Bảo Hân" isExecutable="false">
    <bpmn:laneSet id="LaneSet_QT1_ban_hang">
