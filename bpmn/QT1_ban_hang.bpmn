    <bpmn:messageFlow id="Flow_QT1_ban_hang_4" name="Bánh, phiếu giao" sourceRef="T7" targetRef="K2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_QT1_ban_hang_Ext0" isExecutable="false">
    <bpmn:startEvent id="S1" name="Cần bánh cho ngày mai">
      <bpmn:outgoing>Flow_QT1_ban_hang_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="K1" name="Đặt bánh (Zalo, điện thoại, cổng, API)">
      <bpmn:incoming>Flow_QT1_ban_hang_0</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="K2" name="Nhận bánh, ký phiếu giao">
      <bpmn:incoming>Flow_QT1_ban_hang_2</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="KE" name="Đã nhận hàng">
      <bpmn:incoming>Flow_QT1_ban_hang_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_QT1_ban_hang_0" sourceRef="S1" targetRef="K1" />
