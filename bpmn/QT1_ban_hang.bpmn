      <bpmn:outgoing>Flow_QT1_ban_hang_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_QT1_ban_hang_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T8" name="Ghi số thực giao; hàng thu hồi vào Khu cách ly">
      <bpmn:incoming>Flow_QT1_ban_hang_12</bpmn:incoming>
      <bpmn:outgoing>Flow_QT1_ban_hang_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T9" name="Xác nhận phiếu giao">
